# =====================================================================
# PROJECT LEGAL MODEL: ZERO ASSETS IN THE REPOSITORY
#
# This port ships CODE ONLY. Nothing owned by Rockstar / Take-Two goes in
# here: not the executable, not the game DLLs, not the assets, not dumps
# derived from them. Every user supplies their own copy of the game (installed
# folder or disc ISO) and the repo tools extract what they need.
#
# Before adding anything, check that it does not come from the game.
# =====================================================================

# ---- Game install and reference binaries: NEVER commit ----
MH2GAME/
ORIGINAL/
*.exe
*.dll
*.asi
*.pdb

# ---- Game assets ----
*.iso
*.mdf
*.mds
*.bin
*.cue
*.mls
*.gxt
*.txd
*.dff
*.pak
*.bik
*.fsb
*.fev
*.ifp
*.bsp
*.col
*.inst
*.glg
*.fxo

# ---- Analysis derived from the binary: regenerated, never versioned ----
# Reproduce with OUTPUT/tools (see PROGRESS.md, "Reproducing the analysis").
# Everything in OUTPUT/ is generated (Ghidra project, drafts, call trees, logs)
# except our own scripts in OUTPUT/tools/.
OUTPUT/*
!OUTPUT/tools/
recompiled/
decomp/**/_raw/
build/
build32/
build64/

# ---- Third-party tools each user downloads ----
TOOLS/ghidra_*/
TOOLS/GhidraMCP/
TOOLS/rea/
TOOLS/binviz/

# ---- Machine-specific ----
.claude/settings.local.json
.mcp.json

# ---- Usual junk ----
__pycache__/
*.pyc
*.obj
*.o
*.ilk
*.zip
*.rar
Thumbs.db
.DS_Store
.vs/

# ---- Community repos, read-only reference ----
REFERENCE/
